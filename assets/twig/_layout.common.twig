<!doctype html>
<html class="no-js" lang="sk">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">

    <title>{{ block('title') }} | </title>
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="icon" href="favicon.ico" type="image/x-icon" />
    <link rel="shortcut icon" href="favicon.ico" type="image/x-icon" />
    <!-- Place favicon.ico in the root directory -->

    {% include '_social_markup.twig' %}

    <link rel="stylesheet" href="css/cookieconsent.css?v=3.2.1">
    <link rel="stylesheet" href="css/main.css?v=20191013">
    <link href="https://fonts.googleapis.com/css?family=Titillium+Web:600|Open+Sans&amp;subset=latin,latin-ext" rel="stylesheet" type="text/css">
  </head>
  <body>
    <header class="site-header js-site-header">
      <div class="grid-container">
        <div class="grid-x">
          <button class="site-header__menutoggle js-menutoggle"></button>
          <div class="cell small-12 medium-2 large-3"><h1 class="site-header__title">Cestou Zimy</h1></div>
          <div class="cell medium-10 large-9 site-header__navigation">
            <nav class="site-navigation">
              <ul class="site-menu">
                <li class="site-menu__item"><a href="#top" class="site-menu__href">Úvod</a></li>
                <li class="site-menu__item"><a href="#okurze" class="site-menu__href">O kurze</a></li>
                <li class="site-menu__item"><a href="#tim" class="site-menu__href">Tím</a></li>
                <li class="site-menu__item"><a href="#prihlaska" class="site-menu__href">Prihlásenie</a></li>
              </ul>
            </nav>
          </div>
        </div>
      </div>
    </header>

    {% block page %}{% endblock %}

    <button type="button" class="cc-revisit" data-cc="show-preferencesModal" aria-label="Nastavenia cookies" title="Nastavenia cookies" hidden>
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
        <path fill="currentColor" fill-rule="evenodd" d="M21.6 11.2a3 3 0 0 1-3.4-3.4 3 3 0 0 1-3.6-3.6A2 2 0 0 1 13 1.7 10.4 10.4 0 1 0 22.3 11a2 2 0 0 1-.7.2ZM7.5 8.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Zm1 7a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Zm6-1a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Zm-3-4.5a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z"/>
      </svg>
    </button>

    <script src="js/jquery.min.js"></script>
    <script src="js/cookieconsent.umd.js?v=3.2.1"></script>
    <script src="js/main.js"></script>
  </body>
</html>

