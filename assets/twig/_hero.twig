<section class="section intro">
  <div class="intro__inner">
    <div class="intro__bg"></div>
    <div class="intro__textpart">
      <div class="intro__lead hide-for-medium">
        <p class="intro__claim">{{ claim }}</p>
        {# From medium up the photo is hidden, so desktops get a 1×1 GIF instead of downloading it #}
        <picture>
          <source media="(min-width: 40em)" srcset="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7">
          <img src="/images/gallery/zimnykurz-11.jpg" width="1000" height="662" alt="Stany v snehu na zimnom kurze" class="intro__photo">
        </picture>
      </div>
      <h1 class="intro__title">Cestou Zimy</h1>
      <h2 class="intro__subtitle">Zimný kurz od <a href="http://plusko.net/" target="_blank" title="Plusko – zážitková organizácia"><img src="/images/logo-plusko.png" alt="Logo organizácie Plusko – zážitková organizácia" class="intro__organizerlogo"></a></h2>
      
      <p class="intro__date">{{ altdate }}</p>
      <p class="intro__altdatexplain">Víkendové stretnutie s účastníkmi na Myjave.</p>
      <p class="intro__date">{{ date }}</p>
      <p class="intro__altdatexplain">Putovná časť zimného kurzu vo Veľkej Fatre.</p>
      {#<p class="intro__date">vo Veľkej Fatre</p>#}
      {#<p class="intro__altdate"><br>iný text</p>#}
      <p>&nbsp;</p>
      <p><a href="#okurze" class="button">Zisti viac</a></p>
    </div>
    <div class="intro__imgpart"></div>
  </div>
</section>
